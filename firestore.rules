rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Primary email plus verified emails connected to this account (mirrored as a custom claim).
    function authEmails() {
      return [request.auth.token.email.lower()].concat(request.auth.token.get('linkedEmails', []));
    }

    function hasBoundedListLimit(maximum) {
      return request.query.limit != null && request.query.limit <= maximum;
    }

    function isPlatformAdmin() {
      return signedIn() &&
        (request.auth.token.email == 'dextersargent@flagos.ca' ||
         request.auth.token.email == 'dextersargent@gmail.com');
    }

    // Independent (league-free) teams can opt into a public portal by setting
    // visibility to 'public'. PII lives only in team_private/player_private.
    function isPublicIndependentTeamData(data) {
      return hasNoTeamPii(data) &&
        data.get('leagueId', '') == '' &&
        data.get('visibility', '') == 'public';
    }

    function isPublicIndependentTeam(teamId) {
      let teamPath = /databases/$(database)/documents/teams/$(teamId);
      return teamId is string && teamId != '' &&
        exists(teamPath) && isPublicIndependentTeamData(get(teamPath).data);
    }

    function isPublicTeamMatch(data) {
      return data.get('isHidden', true) == false &&
        data.get('leagueId', '') == '' &&
        isPublicIndependentTeam(data.get('managingTeamId', ''));
    }

    function isPublicTeamPlayer(data) {
      return hasNoPlayerPii(data) &&
        data.get('leagueId', '') == '' &&
        isPublicIndependentTeam(data.get('teamId', ''));
    }

    function isPublicTeamPlay(data) {
      let matchPath = /databases/$(database)/documents/matches/$(data.get('matchId', ''));
      // A match can subsequently be hidden, so its visibility remains authoritative.
      return data.get('isHidden', true) == false &&
        exists(matchPath) && isPublicTeamMatch(get(matchPath).data);
    }

    // The head coach is the first listed admin email (or the legacy coachEmail).
    function isPrimaryTeamAdmin(teamId) {
      let privateTeamPath = /databases/$(database)/documents/team_private/$(teamId);
      return isPlatformAdmin() ||
        (signedIn() && teamId is string && teamId != '' && exists(privateTeamPath) &&
          (
            (get(privateTeamPath).data.get('adminEmails', []) is list &&
              get(privateTeamPath).data.get('adminEmails', []).size() > 0 &&
              get(privateTeamPath).data.adminEmails[0] is string &&
              get(privateTeamPath).data.adminEmails[0].lower() in authEmails()) ||
            (get(privateTeamPath).data.get('adminEmails', []).size() == 0 &&
              get(privateTeamPath).data.get('coachEmail', '') is string &&
              get(privateTeamPath).data.get('coachEmail', '').lower() in authEmails())
          ));
    }

    function isLeagueAdminOfTeam(teamId) {
      let teamPath = /databases/$(database)/documents/teams/$(teamId);
      return teamId is string && teamId != '' && exists(teamPath) &&
        get(teamPath).data.get('leagueId', '') != '' &&
        isLeagueAdmin(get(teamPath).data.get('leagueId', ''));
    }

    function isPublicLeaguePlay(data) {
      let matchPath = /databases/$(database)/documents/matches/$(data.get('matchId', ''));
      return data.get('isHidden', true) == false &&
        canViewLeague(data.get('leagueId', '')) &&
        exists(matchPath) && get(matchPath).data.get('isHidden', true) == false;
    }

    function isTeamAdmin(teamId) {
      let teamPath = /databases/$(database)/documents/teams/$(teamId);
      let privateTeamPath = /databases/$(database)/documents/team_private/$(teamId);
      return isPlatformAdmin() ||
        (signedIn() &&
          teamId is string &&
          (
            (exists(privateTeamPath) &&
              (
                (get(privateTeamPath).data.adminEmails is list &&
                  get(privateTeamPath).data.adminEmails.hasAny(authEmails())) ||
                (get(privateTeamPath).data.coachEmail is string &&
                  get(privateTeamPath).data.coachEmail.lower() in authEmails()) ||
                (get(privateTeamPath).data.adminEmail is string &&
                  get(privateTeamPath).data.adminEmail.lower() in authEmails())
              )) ||
            (exists(teamPath) &&
          (
            (get(teamPath).data.adminEmails is list &&
              get(teamPath).data.adminEmails.hasAny(authEmails())) ||
            (get(teamPath).data.coachEmail is string &&
              get(teamPath).data.coachEmail.lower() in authEmails()) ||
            (get(teamPath).data.adminEmail is string &&
              get(teamPath).data.adminEmail.lower() in authEmails())
          ))
          ));
    }

    function isLeagueAdmin(leagueId) {
      let leaguePath = /databases/$(database)/documents/leagues/$(leagueId);
      let privateLeaguePath = /databases/$(database)/documents/league_private/$(leagueId);
      return isPlatformAdmin() ||
        (signedIn() &&
          leagueId is string &&
          (
            (exists(privateLeaguePath) &&
              (
                (get(privateLeaguePath).data.ownerUid is string &&
                  get(privateLeaguePath).data.ownerUid == request.auth.uid) ||
                (get(privateLeaguePath).data.adminEmails is list &&
                  get(privateLeaguePath).data.adminEmails.hasAny(authEmails())) ||
                (get(privateLeaguePath).data.subscriptionAdminEmails is list &&
                  get(privateLeaguePath).data.subscriptionAdminEmails.hasAny(authEmails()))
              )) ||
            (exists(leaguePath) &&
          (
            (get(leaguePath).data.ownerUid is string &&
              get(leaguePath).data.ownerUid == request.auth.uid) ||
            (get(leaguePath).data.adminEmails is list &&
              get(leaguePath).data.adminEmails.hasAny(authEmails()))
          ))
          ));
    }

    function isPublicLeague(leagueId) {
      let leaguePath = /databases/$(database)/documents/leagues/$(leagueId);
      return leagueId is string && exists(leaguePath) &&
        get(leaguePath).data.visibility == 'public';
    }

    // Players and coaches of a league (public or private). The server keeps
    // league_access/{uid} in sync with rosters whenever it resolves the account.
    function isLeagueMember(leagueId) {
      let accessPath = /databases/$(database)/documents/league_access/$(request.auth.uid);
      return signedIn() && leagueId is string && leagueId != '' && exists(accessPath) &&
        get(accessPath).data.get('leagueIds', []) is list &&
        leagueId in get(accessPath).data.get('leagueIds', []);
    }

    function canViewLeague(leagueId) {
      return isLeagueMember(leagueId) || isPublicLeague(leagueId);
    }

    // A temporary scorer can read the league, its teams and rosters while their grant lasts,
    // so private-league games can be scored by someone who isn't a member.
    function hasScorerLeagueAccess(leagueId) {
      let accessPath = /databases/$(database)/documents/scorer_league_access/$(leagueId + '__' + request.auth.uid);
      return signedIn() && leagueId is string && leagueId != '' && exists(accessPath) &&
        get(accessPath).data.uid == request.auth.uid &&
        get(accessPath).data.expiresAt > request.time;
    }

    function isPlayerOwner(playerId) {
      let privatePlayerPath = /databases/$(database)/documents/player_private/$(playerId);
      return signedIn() &&
        playerId is string &&
        exists(privatePlayerPath) &&
        (
          (get(privatePlayerPath).data.email is string &&
            get(privatePlayerPath).data.email.lower() in authEmails()) ||
          (get(privatePlayerPath).data.emails is list &&
            get(privatePlayerPath).data.emails.hasAny(authEmails()))
        );
    }

    function hasNoLeaguePii(data) {
      return !data.keys().hasAny(['adminEmails', 'contactEmail']) &&
        (!('subscription' in data) ||
          (data.subscription is map && !data.subscription.keys().hasAny(['adminEmails'])));
    }

    function hasNoTeamPii(data) {
      return !data.keys().hasAny(['adminEmails', 'coachEmail', 'adminEmail', 'email']);
    }

    function hasNoPlayerPii(data) {
      return !data.keys().hasAny(['email', 'emails']);
    }

    function canManageTeam(teamId, leagueId) {
      return isPlatformAdmin() ||
        (teamId is string && teamId != '' && isTeamAdmin(teamId)) ||
        (leagueId is string && leagueId != '' && isLeagueAdmin(leagueId));
    }

    // Archived leagues are read-only for season data (teams, players, matches, plays).
    function isLeagueWritable(leagueId) {
      return !(leagueId is string) || leagueId == '' || isDocUnarchived(/databases/$(database)/documents/leagues/$(leagueId));
    }

    // Independent teams archive their own season on the team document.
    function isTeamSeasonWritable(teamId) {
      return !(teamId is string) || teamId == '' || isDocUnarchived(/databases/$(database)/documents/teams/$(teamId));
    }

    // Only the league's current season accepts game and play edits; earlier seasons are frozen.
    // Records without a seasonId belong to the league's first season.
    function isSeasonWritable(data) {
      return !(data.get('leagueId', '') is string) || data.get('leagueId', '') == '' ||
        !exists(/databases/$(database)/documents/leagues/$(data.get('leagueId', ''))) ||
        get(/databases/$(database)/documents/leagues/$(data.get('leagueId', ''))).data.get('currentSeasonId', 'season-1') ==
          data.get('seasonId', 'season-1');
    }

    function isDocUnarchived(path) {
      return !exists(path) ||
        (get(path).data.get('isArchived', false) != true &&
          get(path).data.get('seasonStatus', '') != 'archived');
    }

    function isValidLeague(data) {
      return data.keys().hasOnly([
          'leagueName', 'shortcode', 'tagline', 'seasonTitle', 'logoUrl', 'icon',
          'primaryColor', 'accentColor', 'themePreset', 'defaultLocation',
          'rulebookTitle', 'rulebookUrl', 'announcement',
          'seasonStatus', 'isArchived', 'archivedAt', 'visibility',
          'ownerUid', 'rules', 'playoffFormat', 'subscription', 'createdAt',
          'updatedAt', 'teamCount', 'name', 'id'
        ]) &&
        data.leagueName is string && data.leagueName.size() > 0 &&
        data.leagueName.size() <= 100 &&
        data.shortcode is string && data.shortcode.size() > 0 &&
        data.shortcode.size() <= 12 &&
        data.tagline is string && data.tagline.size() <= 240 &&
        data.seasonTitle is string && data.seasonTitle.size() <= 100 &&
        data.primaryColor is string && data.primaryColor.matches('^#[0-9A-Fa-f]{6}$') &&
        data.accentColor is string && data.accentColor.matches('^#[0-9A-Fa-f]{6}$') &&
        data.visibility in ['public', 'private'] &&
        hasNoLeaguePii(data) &&
        data.rules is map && data.rules.keys().size() <= 30 &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 350000)) &&
        (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 2000)) &&
        (!('teamCount' in data) || (data.teamCount is int && data.teamCount >= 4 && data.teamCount <= 64)) &&
        (!('ownerUid' in data) || data.ownerUid is string);
    }

    function isValidTeam(data) {
      return data.keys().size() <= 80 &&
        hasNoTeamPii(data) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 80 &&
        (!('leagueId' in data) || (data.leagueId is string && data.leagueId.size() <= 128)) &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 350000)) &&
        (!('visibleTeamStats' in data) ||
          (data.visibleTeamStats is list && data.visibleTeamStats.size() <= 50)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000));
    }

    function isValidPlayer(data) {
      return data.keys().size() <= 80 &&
        hasNoPlayerPii(data) &&
        data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 100 &&
        data.teamId is string && data.teamId.size() <= 128 &&
        (!('positions' in data) ||
          (data.positions is list && data.positions.size() <= 10)) &&
        (!('number' in data) || (data.number is string && data.number.size() <= 4)) &&
        (!('experience' in data) || (data.experience is string && data.experience.size() <= 1000)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidMatch(data) {
      return data.keys().size() <= 100 &&
        (!('leagueId' in data) || (data.leagueId is string && data.leagueId.size() <= 128)) &&
        (!('homeTeamId' in data) || (data.homeTeamId is string && data.homeTeamId.size() <= 128)) &&
        (!('awayTeamId' in data) || (data.awayTeamId is string && data.awayTeamId.size() <= 128)) &&
        (!('managingTeamId' in data) || (data.managingTeamId is string && data.managingTeamId.size() <= 128)) &&
        (!('homeTeamName' in data) || (data.homeTeamName is string && data.homeTeamName.size() <= 100)) &&
        (!('awayTeamName' in data) || (data.awayTeamName is string && data.awayTeamName.size() <= 100)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        (!('subs' in data) || (data.subs is list && data.subs.size() <= 100)) &&
        (!('liveHeartbeatAt' in data) || data.liveHeartbeatAt == null || data.liveHeartbeatAt is timestamp) &&
        (!('isHidden' in data) || data.isHidden is bool);
    }

    function isValidPlay(data) {
      return data.keys().size() <= 60 &&
        (!('matchId' in data) || (data.matchId is string && data.matchId.size() <= 128)) &&
        (!('teamId' in data) || (data.teamId is string && data.teamId.size() <= 128)) &&
        (!('leagueId' in data) || (data.leagueId is string && data.leagueId.size() <= 128)) &&
        (!('type' in data) || (data.type is string && data.type.size() <= 80)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        (!('playStatement' in data) || (data.playStatement is string && data.playStatement.size() <= 2000)) &&
        (!('defenders' in data) || (data.defenders is list && data.defenders.size() <= 10)) &&
        (!('flaggers' in data) || (data.flaggers is list && data.flaggers.size() <= 10)) &&
        (!('isHidden' in data) || data.isHidden is bool) &&
        (!('timestamp' in data) || data.timestamp is timestamp);
    }

    // Temporary scorer access to one game, issued by a league admin through /api/scorer-access.
    function hasScorerGrant(matchId) {
      let grantPath = /databases/$(database)/documents/scorer_grants/$(matchId + '__' + request.auth.uid);
      return signedIn() && matchId is string && exists(grantPath) &&
        get(grantPath).data.uid == request.auth.uid &&
        get(grantPath).data.expiresAt > request.time;
    }

    function canManageMatch(matchId) {
      let matchPath = /databases/$(database)/documents/matches/$(matchId);
      return isPlatformAdmin() || hasScorerGrant(matchId) ||
        (matchId is string && exists(matchPath) &&
          (
            canManageTeam(
              get(matchPath).data.get('managingTeamId', ''),
              get(matchPath).data.get('leagueId', '')
            ) ||
            canManageTeam(
              get(matchPath).data.get('homeTeamId', ''),
              get(matchPath).data.get('leagueId', '')
            ) ||
            canManageTeam(
              get(matchPath).data.get('awayTeamId', ''),
              get(matchPath).data.get('leagueId', '')
            )
          ));
    }

    function isValidUser(data, userId) {
      return data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == userId &&
        data.email is string && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.role == 'user' &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Public league discovery is intentionally limited to public settings.
    // Members and admins can read private league documents.
    match /leagues/{leagueId} {
      allow get: if signedIn() && hasNoLeaguePii(resource.data) &&
        (resource.data.visibility == 'public' || isLeagueMember(leagueId) || isLeagueAdmin(leagueId) ||
          hasScorerLeagueAccess(leagueId));
      allow list: if hasBoundedListLimit(100) &&
        signedIn() && hasNoLeaguePii(resource.data) &&
        (resource.data.visibility == 'public' || isLeagueMember(leagueId) || isLeagueAdmin(leagueId) ||
          hasScorerLeagueAccess(leagueId));
      allow create: if false;
      allow update: if isLeagueAdmin(leagueId) &&
        isValidLeague(request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow get: if isPublicIndependentTeamData(resource.data) ||
        (signedIn() && hasNoTeamPii(resource.data) &&
        (isPlatformAdmin() || isTeamAdmin(teamId) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)) ||
          (resource.data.leagueId is string && canViewLeague(resource.data.leagueId)) ||
          (resource.data.leagueId is string && hasScorerLeagueAccess(resource.data.leagueId))));
      allow list: if hasBoundedListLimit(300) &&
        signedIn() && hasNoTeamPii(resource.data) &&
        (isPlatformAdmin() || isTeamAdmin(teamId) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)) ||
          (resource.data.leagueId is string && canViewLeague(resource.data.leagueId)) ||
          (resource.data.leagueId is string && hasScorerLeagueAccess(resource.data.leagueId)));
      allow create: if false;
      allow update: if isLeagueWritable(resource.data.get('leagueId', '')) &&
        canManageTeam(resource.data.id == teamId ? resource.data.id : teamId, resource.data.leagueId) &&
        isValidTeam(request.resource.data) &&
        request.resource.data.leagueId == resource.data.leagueId;
      allow delete: if false;

      match /meta/{metaId} {
        allow read: if isTeamAdmin(teamId) || isLeagueAdmin(get(/databases/$(database)/documents/teams/$(teamId)).data.leagueId);
        allow create, update: if false;
        allow delete: if metaId == 'playbook' &&
          (isPrimaryTeamAdmin(teamId) || isLeagueAdminOfTeam(teamId));
      }
    }

    match /players/{playerId} {
      allow get: if isPublicTeamPlayer(resource.data) ||
        (signedIn() && hasNoPlayerPii(resource.data) &&
        (isPlatformAdmin() ||
          hasScorerLeagueAccess(resource.data.leagueId) ||
          isPlayerOwner(playerId) ||
          isLeagueAdmin(resource.data.leagueId) ||
          (resource.data.teamId is string && resource.data.teamId != '' && isTeamAdmin(resource.data.teamId)) ||
          canViewLeague(resource.data.leagueId)));
      allow list: if hasBoundedListLimit(1920) &&
        (isPublicTeamPlayer(resource.data) ||
        (signedIn() && hasNoPlayerPii(resource.data) &&
        (isPlatformAdmin() ||
          hasScorerLeagueAccess(resource.data.leagueId) ||
          isPlayerOwner(playerId) ||
          isLeagueAdmin(resource.data.leagueId) ||
          (resource.data.teamId is string && resource.data.teamId != '' && isTeamAdmin(resource.data.teamId)) ||
          canViewLeague(resource.data.leagueId))));
      allow create: if false;
      allow update: if isValidPlayer(request.resource.data) &&
        isLeagueWritable(resource.data.get('leagueId', '')) &&
        isTeamSeasonWritable(resource.data.get('teamId', '')) &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.leagueId == resource.data.leagueId &&
        (
          isPlatformAdmin() ||
          isLeagueAdmin(resource.data.leagueId) ||
          (resource.data.teamId is string && resource.data.teamId != '' && isTeamAdmin(resource.data.teamId))
        );
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow get: if isPublicTeamMatch(resource.data) || (signedIn() &&
        (isPlatformAdmin() || hasScorerGrant(matchId) ||
          (resource.data.managingTeamId is string && isTeamAdmin(resource.data.managingTeamId)) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)) ||
          (resource.data.isHidden != true && canViewLeague(resource.data.leagueId))));
      allow list: if hasBoundedListLimit(512) &&
        (isPublicTeamMatch(resource.data) || (signedIn() &&
        (isPlatformAdmin() ||
          (resource.data.managingTeamId is string && isTeamAdmin(resource.data.managingTeamId)) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)) ||
          (resource.data.isHidden != true && canViewLeague(resource.data.leagueId)))));
      allow create: if false;
      allow update: if isValidMatch(request.resource.data) &&
        isLeagueWritable(resource.data.get('leagueId', '')) &&
        isTeamSeasonWritable(resource.data.get('managingTeamId', '')) &&
        isSeasonWritable(resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'createdAt', 'isStandalone', 'leagueId', 'homeTeamId', 'awayTeamId', 'managingTeamId', 'seasonId'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isHidden']) ||
          isPrimaryTeamAdmin(resource.data.get('managingTeamId', '')) ||
          (resource.data.get('leagueId', '') != '' && isLeagueAdmin(resource.data.get('leagueId', '')))) &&
        canManageMatch(matchId);
      allow delete: if canManageMatch(matchId) &&
        isLeagueWritable(resource.data.get('leagueId', '')) &&
        isSeasonWritable(resource.data) &&
        isTeamSeasonWritable(resource.data.get('managingTeamId', '')) &&
        (isPrimaryTeamAdmin(resource.data.get('managingTeamId', '')) ||
          (resource.data.get('leagueId', '') != '' && isLeagueAdmin(resource.data.get('leagueId', ''))));
    }

    match /plays/{playId} {
      allow get: if isPublicTeamPlay(resource.data) || (signedIn() &&
        (isPlatformAdmin() ||
          (resource.data.teamId is string && isTeamAdmin(resource.data.teamId)) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)) ||
          (resource.data.matchId is string && canManageMatch(resource.data.matchId)) ||
          isPublicLeaguePlay(resource.data)));
      allow list: if hasBoundedListLimit(10000) &&
        // Queries can't follow each play to its match, so league queries rely on the play's
        // own isHidden flag (copied from the match when the play is recorded).
        ((signedIn() && resource.data.isHidden != true && canViewLeague(resource.data.leagueId)) ||
        isPublicTeamPlay(resource.data) || (signedIn() &&
        (isPlatformAdmin() ||
          (resource.data.teamId is string && isTeamAdmin(resource.data.teamId)) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)) ||
          (resource.data.matchId is string && canManageMatch(resource.data.matchId)) ||
          isPublicLeaguePlay(resource.data))));
      allow create: if false;
      allow update: if isValidPlay(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'createdAt', 'matchId', 'leagueId', 'teamId', 'managingTeamId', 'isHidden', 'seasonId'
        ]) &&
        isLeagueWritable(resource.data.get('leagueId', '')) &&
        isSeasonWritable(resource.data) &&
        isTeamSeasonWritable(resource.data.get('managingTeamId', '')) &&
        (canManageTeam(resource.data.teamId, resource.data.leagueId) ||
          canManageMatch(resource.data.matchId));
      allow delete: if isLeagueWritable(resource.data.get('leagueId', '')) &&
        isTeamSeasonWritable(resource.data.get('managingTeamId', '')) &&
        isSeasonWritable(resource.data) &&
        (canManageTeam(resource.data.teamId, resource.data.leagueId) ||
        canManageMatch(resource.data.matchId));
    }

    match /red_plays/{playId} {
      allow get: if signedIn() &&
        (isPlatformAdmin() ||
          (resource.data.teamId is string && isTeamAdmin(resource.data.teamId)) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)));
      allow list: if hasBoundedListLimit(10000) &&
        signedIn() &&
        (isPlatformAdmin() ||
          (resource.data.teamId is string && isTeamAdmin(resource.data.teamId)) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)));
      allow create: if false;
      allow update: if isValidPlay(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'createdAt', 'matchId', 'leagueId', 'teamId', 'managingTeamId', 'isHidden'
        ]) &&
        (canManageTeam(resource.data.teamId, resource.data.leagueId) ||
          canManageMatch(resource.data.matchId));
      allow delete: if canManageTeam(resource.data.teamId, resource.data.leagueId) ||
        canManageMatch(resource.data.matchId);
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'user' &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        isValidUser(request.resource.data, userId);
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        isValidUser(request.resource.data, userId);
      allow delete: if isPlatformAdmin();
    }

    // Public submission spam is disabled until submissions use a verified,
    // server-mediated endpoint with rate limiting and data retention controls.
    match /registration_submissions/{submissionId} {
      allow read, write: if false;
    }

    // Frozen standings and stat lines for completed seasons; written only by the server.
    match /league_seasons/{seasonDocId} {
      allow get: if signedIn() && resource.data.leagueId is string &&
        (isPlatformAdmin() || isLeagueAdmin(resource.data.leagueId) || canViewLeague(resource.data.leagueId));
      allow list: if hasBoundedListLimit(50) && signedIn() && resource.data.leagueId is string &&
        (isPlatformAdmin() || isLeagueAdmin(resource.data.leagueId) || canViewLeague(resource.data.leagueId));
      allow write: if false;
    }

    // A scorer can confirm their own grant; links and grants are only written by the server.
    match /scorer_grants/{grantId} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow list, write: if false;
    }

    match /scorer_league_access/{accessId} {
      allow read, write: if false;
    }

    match /scorer_invites/{inviteId} {
      allow read, write: if false;
    }

    match /league_access/{userId} {
      allow read, write: if false;
    }

    match /league_private/{leagueId} {
      allow read, write: if false;
    }

    // Public free-agent interest is written only by the rate-limited server route.
    match /free_agent_interest/{entryId} {
      allow get, delete: if isPlatformAdmin();
      allow list: if isPlatformAdmin() && hasBoundedListLimit(200);
      allow create, update: if false;
    }

    match /team_private/{teamId} {
      allow read, write: if false;
    }

    match /player_private/{playerId} {
      allow read, write: if false;
    }

    match /write_counters/{counterId} {
      allow read, write: if false;
    }

    match /user_write_limits/{userId} {
      allow read, write: if false;
    }

    match /user_private_read_limits/{userId} {
      allow read, write: if false;
    }
  }
}
