rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function hasBoundedListLimit(maximum) {
      return request.query.limit != null && request.query.limit <= maximum;
    }

    function isPlatformAdmin() {
      return signedIn() &&
        request.auth.token.email == 'dextersargent@gmail.com';
    }

    // York fixtures are public only when explicitly visible. Staff access is
    // team-scoped and never changes the platform administrator allowlist.
    function isYorkTeam(teamId) {
      return teamId is string && teamId.lower() in [
        'york_lions', 'team_york', 'york', 'yuwffl_lions', 'york_wffl'
      ];
    }

    function isYorkStaff(teamId) {
      return signedIn() && isYorkTeam(teamId) &&
        request.auth.token.email.lower() in [
          'dextersargent@gmail.com', 'dexters4@my.yorku.ca',
          'tbrown99@my.yorku.ca', 'theobrown24@icloud.com', 'theoren911@gmail.com',
          'fawcett1@my.yorku.ca', 'justinfawcett93@gmail.com'
        ];
    }

    function isYorkHeadCoach(teamId) {
      return signedIn() && isYorkTeam(teamId) &&
        request.auth.token.email.lower() in [
          'dextersargent@gmail.com', 'dexters4@my.yorku.ca'
        ];
    }

    function isPublicYorkMatch(data) {
      return data.get('isHidden', true) == false &&
        (isYorkTeam(data.get('homeTeamId', '')) ||
          isYorkTeam(data.get('awayTeamId', '')) ||
          isYorkTeam(data.get('managingTeamId', '')));
    }

    function isPublicYorkTeamData(teamId, data) {
      return isYorkTeam(teamId) && hasNoTeamPii(data) &&
        data.get('visibility', '') == 'public';
    }

    function isPublicYorkPlayer(data) {
      let teamPath = /databases/$(database)/documents/teams/$(data.get('teamId', ''));
      return hasNoPlayerPii(data) && isYorkTeam(data.get('teamId', '')) &&
        exists(teamPath) && isPublicYorkTeamData(data.get('teamId', ''), get(teamPath).data);
    }

    function isPublicYorkPlay(data) {
      let matchPath = /databases/$(database)/documents/matches/$(data.get('matchId', ''));
      // A match can subsequently be hidden, so its visibility remains authoritative.
      return data.get('isHidden', true) == false &&
        exists(matchPath) && isPublicYorkMatch(get(matchPath).data);
    }

    function isPublicLeaguePlay(data) {
      let matchPath = /databases/$(database)/documents/matches/$(data.get('matchId', ''));
      return data.get('isHidden', true) == false &&
        isPublicLeague(data.get('leagueId', '')) &&
        exists(matchPath) && get(matchPath).data.get('isHidden', true) == false;
    }

    function isYorkSeedMatch(matchId, data) {
      return matchId in [
          'match_york_mcmaster', 'match_york_waterloo', 'match_york_ottawa',
          'match_york_canadore', 'match_york_laurier'
        ] &&
        data.get('managingTeamId', '') == 'york_lions' &&
        data.get('homeTeamId', '') == 'york_lions' &&
        data.get('awayTeamId', '') == 'opponent_' + matchId.replace('match_york_', '') &&
        data.get('leagueId', '') == '' &&
        isYorkStaff('york_lions') &&
        (data.get('isHidden', true) == false || isYorkHeadCoach('york_lions'));
    }

    function isTeamAdmin(teamId) {
      let teamPath = /databases/$(database)/documents/teams/$(teamId);
      let privateTeamPath = /databases/$(database)/documents/team_private/$(teamId);
      return isPlatformAdmin() || isYorkStaff(teamId) ||
        (signedIn() &&
          teamId is string &&
          (
            (exists(privateTeamPath) &&
              (
                (get(privateTeamPath).data.adminEmails is list &&
                  request.auth.token.email.lower() in get(privateTeamPath).data.adminEmails) ||
                (get(privateTeamPath).data.coachEmail is string &&
                  get(privateTeamPath).data.coachEmail.lower() == request.auth.token.email.lower()) ||
                (get(privateTeamPath).data.adminEmail is string &&
                  get(privateTeamPath).data.adminEmail.lower() == request.auth.token.email.lower())
              )) ||
            (exists(teamPath) &&
          (
            (get(teamPath).data.adminEmails is list &&
              request.auth.token.email.lower() in get(teamPath).data.adminEmails) ||
            (get(teamPath).data.coachEmail is string &&
              get(teamPath).data.coachEmail.lower() == request.auth.token.email.lower()) ||
            (get(teamPath).data.adminEmail is string &&
              get(teamPath).data.adminEmail.lower() == request.auth.token.email.lower())
          ))
          ));
    }

    function isLeagueAdmin(leagueId) {
      let leaguePath = /databases/$(database)/documents/leagues/$(leagueId);
      let privateLeaguePath = /databases/$(database)/documents/league_private/$(leagueId);
      return isPlatformAdmin() ||
        (signedIn() &&
          leagueId is string &&
          (
            (exists(privateLeaguePath) &&
              (
                (get(privateLeaguePath).data.ownerUid is string &&
                  get(privateLeaguePath).data.ownerUid == request.auth.uid) ||
                (get(privateLeaguePath).data.adminEmails is list &&
                  request.auth.token.email.lower() in get(privateLeaguePath).data.adminEmails) ||
                (get(privateLeaguePath).data.subscriptionAdminEmails is list &&
                  request.auth.token.email.lower() in get(privateLeaguePath).data.subscriptionAdminEmails)
              )) ||
            (exists(leaguePath) &&
          (
            (get(leaguePath).data.ownerUid is string &&
              get(leaguePath).data.ownerUid == request.auth.uid) ||
            (get(leaguePath).data.adminEmails is list &&
              request.auth.token.email.lower() in get(leaguePath).data.adminEmails)
          ))
          ));
    }

    function isPublicLeague(leagueId) {
      let leaguePath = /databases/$(database)/documents/leagues/$(leagueId);
      return leagueId is string && exists(leaguePath) &&
        get(leaguePath).data.visibility == 'public';
    }

    function isPlayerOwner(playerId) {
      let privatePlayerPath = /databases/$(database)/documents/player_private/$(playerId);
      return signedIn() &&
        playerId is string &&
        exists(privatePlayerPath) &&
        (
          (get(privatePlayerPath).data.email is string &&
            get(privatePlayerPath).data.email.lower() == request.auth.token.email.lower()) ||
          (get(privatePlayerPath).data.emails is list &&
            request.auth.token.email.lower() in get(privatePlayerPath).data.emails)
        );
    }

    function hasNoLeaguePii(data) {
      return !data.keys().hasAny(['adminEmails', 'contactEmail']) &&
        (!('subscription' in data) ||
          (data.subscription is map && !data.subscription.keys().hasAny(['adminEmails'])));
    }

    function hasNoTeamPii(data) {
      return !data.keys().hasAny(['adminEmails', 'coachEmail', 'adminEmail', 'email']);
    }

    function hasNoPlayerPii(data) {
      return !data.keys().hasAny(['email', 'emails']);
    }

    function canManageTeam(teamId, leagueId) {
      return isPlatformAdmin() ||
        (teamId is string && teamId != '' && isTeamAdmin(teamId)) ||
        (leagueId is string && leagueId != '' && isLeagueAdmin(leagueId));
    }

    function isValidLeague(data) {
      return data.keys().hasOnly([
          'leagueName', 'shortcode', 'tagline', 'seasonTitle', 'logoUrl', 'icon',
          'primaryColor', 'accentColor', 'themePreset', 'defaultLocation',
          'rulebookTitle', 'rulebookUrl', 'announcement',
          'seasonStatus', 'isArchived', 'archivedAt', 'visibility',
          'ownerUid', 'rules', 'playoffFormat', 'subscription', 'createdAt',
          'updatedAt', 'teamCount', 'name', 'id'
        ]) &&
        data.leagueName is string && data.leagueName.size() > 0 &&
        data.leagueName.size() <= 100 &&
        data.shortcode is string && data.shortcode.size() > 0 &&
        data.shortcode.size() <= 12 &&
        data.tagline is string && data.tagline.size() <= 240 &&
        data.seasonTitle is string && data.seasonTitle.size() <= 100 &&
        data.primaryColor is string && data.primaryColor.matches('^#[0-9A-Fa-f]{6}$') &&
        data.accentColor is string && data.accentColor.matches('^#[0-9A-Fa-f]{6}$') &&
        data.visibility in ['public', 'private'] &&
        hasNoLeaguePii(data) &&
        data.rules is map && data.rules.keys().size() <= 30 &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 350000)) &&
        (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 2000)) &&
        (!('teamCount' in data) || (data.teamCount is int && data.teamCount >= 4 && data.teamCount <= 64)) &&
        (!('ownerUid' in data) || data.ownerUid is string);
    }

    function isValidTeam(data) {
      return data.keys().size() <= 80 &&
        hasNoTeamPii(data) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 80 &&
        (!('leagueId' in data) || (data.leagueId is string && data.leagueId.size() <= 128)) &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 350000)) &&
        (!('visibleTeamStats' in data) ||
          (data.visibleTeamStats is list && data.visibleTeamStats.size() <= 50)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000));
    }

    function isValidPlayer(data) {
      return data.keys().size() <= 80 &&
        hasNoPlayerPii(data) &&
        data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 100 &&
        data.teamId is string && data.teamId.size() <= 128 &&
        (!('positions' in data) ||
          (data.positions is list && data.positions.size() <= 10)) &&
        (!('number' in data) || (data.number is string && data.number.size() <= 4)) &&
        (!('experience' in data) || (data.experience is string && data.experience.size() <= 1000)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidMatch(data) {
      return data.keys().size() <= 100 &&
        (!('leagueId' in data) || (data.leagueId is string && data.leagueId.size() <= 128)) &&
        (!('homeTeamId' in data) || (data.homeTeamId is string && data.homeTeamId.size() <= 128)) &&
        (!('awayTeamId' in data) || (data.awayTeamId is string && data.awayTeamId.size() <= 128)) &&
        (!('managingTeamId' in data) || (data.managingTeamId is string && data.managingTeamId.size() <= 128)) &&
        (!('homeTeamName' in data) || (data.homeTeamName is string && data.homeTeamName.size() <= 100)) &&
        (!('awayTeamName' in data) || (data.awayTeamName is string && data.awayTeamName.size() <= 100)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        (!('subs' in data) || (data.subs is list && data.subs.size() <= 100)) &&
        (!('isHidden' in data) || data.isHidden is bool);
    }

    function isValidPlay(data) {
      return data.keys().size() <= 60 &&
        (!('matchId' in data) || (data.matchId is string && data.matchId.size() <= 128)) &&
        (!('teamId' in data) || (data.teamId is string && data.teamId.size() <= 128)) &&
        (!('leagueId' in data) || (data.leagueId is string && data.leagueId.size() <= 128)) &&
        (!('type' in data) || (data.type is string && data.type.size() <= 80)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        (!('playStatement' in data) || (data.playStatement is string && data.playStatement.size() <= 2000)) &&
        (!('defenders' in data) || (data.defenders is list && data.defenders.size() <= 10)) &&
        (!('flaggers' in data) || (data.flaggers is list && data.flaggers.size() <= 10)) &&
        (!('isHidden' in data) || data.isHidden is bool) &&
        (!('timestamp' in data) || data.timestamp is timestamp);
    }

    function canManageMatch(matchId) {
      let matchPath = /databases/$(database)/documents/matches/$(matchId);
      return isPlatformAdmin() ||
        (matchId is string && exists(matchPath) &&
          (
            canManageTeam(
              get(matchPath).data.get('managingTeamId', ''),
              get(matchPath).data.get('leagueId', '')
            ) ||
            canManageTeam(
              get(matchPath).data.get('homeTeamId', ''),
              get(matchPath).data.get('leagueId', '')
            ) ||
            canManageTeam(
              get(matchPath).data.get('awayTeamId', ''),
              get(matchPath).data.get('leagueId', '')
            )
          ));
    }

    function isValidUser(data, userId) {
      return data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == userId &&
        data.email is string && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.role == 'user' &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Public league discovery is intentionally limited to public settings.
    // Admins retain access to private league documents.
    match /leagues/{leagueId} {
      allow get: if signedIn() && hasNoLeaguePii(resource.data) &&
        (resource.data.visibility == 'public' || isLeagueAdmin(leagueId));
      allow list: if hasBoundedListLimit(100) &&
        signedIn() && hasNoLeaguePii(resource.data) &&
        (resource.data.visibility == 'public' || isLeagueAdmin(leagueId));
      allow create: if false;
      allow update: if isLeagueAdmin(leagueId) &&
        isValidLeague(request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow get: if isPublicYorkTeamData(teamId, resource.data) ||
        (signedIn() && hasNoTeamPii(resource.data) &&
        (isPlatformAdmin() || isTeamAdmin(teamId) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)) ||
          (resource.data.leagueId is string && isPublicLeague(resource.data.leagueId))));
      allow list: if hasBoundedListLimit(300) &&
        signedIn() && hasNoTeamPii(resource.data) &&
        (isPlatformAdmin() || isTeamAdmin(teamId) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)) ||
          (resource.data.leagueId is string && isPublicLeague(resource.data.leagueId)));
      allow create: if false;
      allow update: if canManageTeam(resource.data.id == teamId ? resource.data.id : teamId, resource.data.leagueId) &&
        isValidTeam(request.resource.data) &&
        request.resource.data.leagueId == resource.data.leagueId;
      allow delete: if false;

      match /meta/{metaId} {
        allow read: if isTeamAdmin(teamId) || isLeagueAdmin(get(/databases/$(database)/documents/teams/$(teamId)).data.leagueId);
        allow create, update: if false;
        allow delete: if metaId == 'playbook' &&
          (!isYorkTeam(teamId) || isYorkHeadCoach(teamId)) &&
          (isTeamAdmin(teamId) || isLeagueAdmin(get(/databases/$(database)/documents/teams/$(teamId)).data.leagueId));
      }
    }

    match /players/{playerId} {
      allow get: if isPublicYorkPlayer(resource.data) ||
        (signedIn() && hasNoPlayerPii(resource.data) &&
        (isPlatformAdmin() ||
          isPlayerOwner(playerId) ||
          isLeagueAdmin(resource.data.leagueId) ||
          (resource.data.teamId is string && resource.data.teamId != '' && isTeamAdmin(resource.data.teamId)) ||
          isPublicLeague(resource.data.leagueId)));
      allow list: if hasBoundedListLimit(1920) &&
        (isPublicYorkPlayer(resource.data) ||
        (signedIn() && hasNoPlayerPii(resource.data) &&
        (isPlatformAdmin() ||
          isPlayerOwner(playerId) ||
          isLeagueAdmin(resource.data.leagueId) ||
          (resource.data.teamId is string && resource.data.teamId != '' && isTeamAdmin(resource.data.teamId)) ||
          isPublicLeague(resource.data.leagueId))));
      allow create: if false;
      allow update: if isValidPlayer(request.resource.data) &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.leagueId == resource.data.leagueId &&
        (
          isPlatformAdmin() ||
          isLeagueAdmin(resource.data.leagueId) ||
          (resource.data.teamId is string && resource.data.teamId != '' && isTeamAdmin(resource.data.teamId))
        );
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow get: if isPublicYorkMatch(resource.data) || (signedIn() &&
        (isPlatformAdmin() ||
          (resource.data.managingTeamId is string && isTeamAdmin(resource.data.managingTeamId)) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)) ||
          (resource.data.isHidden != true && isPublicLeague(resource.data.leagueId))));
      allow list: if hasBoundedListLimit(512) &&
        (isPublicYorkMatch(resource.data) || (signedIn() &&
        (isPlatformAdmin() ||
          (resource.data.managingTeamId is string && isTeamAdmin(resource.data.managingTeamId)) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)) ||
          (resource.data.isHidden != true && isPublicLeague(resource.data.leagueId)))));
      allow create: if isYorkSeedMatch(matchId, request.resource.data) &&
        isValidMatch(request.resource.data);
      allow update: if isValidMatch(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'createdAt', 'isPublicYork', 'isStandalone', 'leagueId', 'homeTeamId', 'awayTeamId', 'managingTeamId'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isHidden']) ||
          isYorkHeadCoach(resource.data.get('managingTeamId', ''))) &&
        canManageMatch(matchId);
      allow delete: if canManageMatch(matchId) &&
        (!isYorkTeam(resource.data.get('managingTeamId', '')) ||
          isYorkHeadCoach(resource.data.get('managingTeamId', '')));
    }

    match /plays/{playId} {
      allow get: if isPublicYorkPlay(resource.data) || (signedIn() &&
        (isPlatformAdmin() ||
          (resource.data.teamId is string && isTeamAdmin(resource.data.teamId)) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)) ||
          (resource.data.matchId is string && canManageMatch(resource.data.matchId)) ||
          isPublicLeaguePlay(resource.data)));
      allow list: if hasBoundedListLimit(10000) &&
        (isPublicYorkPlay(resource.data) || (signedIn() &&
        (isPlatformAdmin() ||
          (resource.data.teamId is string && isTeamAdmin(resource.data.teamId)) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)) ||
          (resource.data.matchId is string && canManageMatch(resource.data.matchId)) ||
          isPublicLeaguePlay(resource.data))));
      allow create: if false;
      allow update: if isValidPlay(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'createdAt', 'matchId', 'leagueId', 'teamId', 'managingTeamId', 'isHidden', 'isPublicYork'
        ]) &&
        (canManageTeam(resource.data.teamId, resource.data.leagueId) ||
          canManageMatch(resource.data.matchId));
      allow delete: if canManageTeam(resource.data.teamId, resource.data.leagueId) ||
        canManageMatch(resource.data.matchId);
    }

    match /red_plays/{playId} {
      allow get: if signedIn() &&
        (isPlatformAdmin() ||
          (resource.data.teamId is string && isTeamAdmin(resource.data.teamId)) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)));
      allow list: if hasBoundedListLimit(10000) &&
        signedIn() &&
        (isPlatformAdmin() ||
          (resource.data.teamId is string && isTeamAdmin(resource.data.teamId)) ||
          (resource.data.leagueId is string && isLeagueAdmin(resource.data.leagueId)));
      allow create: if false;
      allow update: if isValidPlay(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'createdAt', 'matchId', 'leagueId', 'teamId', 'managingTeamId', 'isHidden', 'isPublicYork'
        ]) &&
        (canManageTeam(resource.data.teamId, resource.data.leagueId) ||
          canManageMatch(resource.data.matchId));
      allow delete: if canManageTeam(resource.data.teamId, resource.data.leagueId) ||
        canManageMatch(resource.data.matchId);
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'user' &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        isValidUser(request.resource.data, userId);
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        isValidUser(request.resource.data, userId);
      allow delete: if isPlatformAdmin();
    }

    // Public submission spam is disabled until submissions use a verified,
    // server-mediated endpoint with rate limiting and data retention controls.
    match /registration_submissions/{submissionId} {
      allow read, write: if false;
    }

    match /league_private/{leagueId} {
      allow read, write: if false;
    }

    match /team_private/{teamId} {
      allow read, write: if false;
    }

    match /player_private/{playerId} {
      allow read, write: if false;
    }

    match /write_counters/{counterId} {
      allow read, write: if false;
    }

    match /user_write_limits/{userId} {
      allow read, write: if false;
    }

    match /user_private_read_limits/{userId} {
      allow read, write: if false;
    }
  }
}
